    "wordpress-publishing",
    "gutenberg",
    "markdown-to-wordpress",
    "notion",
    "notion-to-wordpress",
    "self-hosted",
    "seo",
    "cli",
    "claude",
    "publishing"
  ],
  "homepage": "https://notipo.com/docs/api/cli",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kfuras/notipo-app.git",
    "directory": "packages/cli"
  }
}
