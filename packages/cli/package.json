  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "notipo": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "notipo",
    "mcp",
    "model-context-protocol",
    "ai-agents",
